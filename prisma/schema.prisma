generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Brewery {
  id        String   @id @default(cuid())
  name      String   @unique
  beers     Beer[]
  createdAt DateTime @default(now())
}

model Beer {
  id        String       @id @default(cuid())
  breweryId String
  brewery   Brewery      @relation(fields: [breweryId], references: [id], onDelete: Cascade)
  name      String
  addedBy   String?
  ratings   BeerRating[]
  createdAt DateTime     @default(now())

  @@unique([breweryId, name])
}

// score is 1-5, validated in the API handlers (no reliable DB check-constraint
// support in this Prisma version). raterName + upsert-on-conflict is how a
// rater edits their own rating - see src/lib/rater.ts.
model BeerRating {
  id        String   @id @default(cuid())
  beerId    String
  beer      Beer     @relation(fields: [beerId], references: [id], onDelete: Cascade)
  raterName String
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([beerId, raterName])
}

model BbqTeam {
  id        String     @id @default(cuid())
  name      String     @unique
  items     FoodItem[]
  createdAt DateTime   @default(now())
}

model FoodItem {
  id        String       @id @default(cuid())
  teamId    String
  team      BbqTeam      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  label     String
  addedBy   String?
  ratings   FoodRating[]
  createdAt DateTime     @default(now())

  @@unique([teamId, label])
}

model FoodRating {
  id         String   @id @default(cuid())
  foodItemId String
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  raterName  String
  score      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([foodItemId, raterName])
}

// date is a local yyyy-mm-dd string (Park City time), not a DateTime - matches
// the page's own "all local-time, no UTC round-trips" convention. One row per
// night that has ever had a booking; bookedSeats is only ever changed via the
// guarded UPDATE in src/lib/dinner-reservations-store.ts so concurrent
// bookings can never oversell a night, including the very first booking on a
// date that doesn't have a row yet.
model DinnerNight {
  date         String              @id
  capacity     Int                 @default(24)
  bookedSeats  Int                 @default(0)
  createdAt    DateTime            @default(now())
  reservations DinnerReservation[]
}

// No login for guests - code + email is the whole trust model, same
// spoofable-by-design tradeoff as rater.ts. code is the confirmation a guest
// is shown/keeps; email is required on cancel so a leaked/guessed id alone
// can't cancel someone else's night.
model DinnerReservation {
  id          String      @id @default(cuid())
  code        String      @unique
  date        String
  night       DinnerNight @relation(fields: [date], references: [date])
  partySize   Int
  leadName    String
  email       String
  note        String      @default("")
  cancelledAt DateTime?
  createdAt   DateTime    @default(now())

  @@index([email])
  @@index([date])
}
