---
import BaseLayout from "../layouts/BaseLayout.astro";
import { availabilityForMonth } from "../lib/dinner-reservations-store";

// Availability is read from Postgres, so this page can no longer be static.
export const prerender = false;

const eveningFlow = [
  { time: "4:00 PM", label: "Meet in Park City" },
  { time: "4:30 PM", label: "Shuttle to the private location" },
  { time: "Evening", label: "Activities, then dinner + drinks" },
  { time: "~9:00 PM", label: "Back in Park City" }
];

const now = new Date();
const initialYear = now.getFullYear();
const initialMonth = now.getMonth();
const initialNights = await availabilityForMonth(initialYear, initialMonth);
---

<BaseLayout
  title="Dinner Reservations"
  description="Reserve a seat at a BYAH dinner night in Park City — up to 24 guests. Pick a date, tell us who's coming, and check out."
  currentPath="/dinner-reservations"
>
  <section>
    <span class="eyebrow">BYAH dinner nights · Park City</span>
    <h1>Dinner Reservations</h1>
    <p class="content-body">
      A private dinner night runs most evenings with up to 24 guests: we meet at
      4:00&nbsp;PM in Park City, drive you to a private location nearby, and
      take care of the rest — activities, dinner, and drinks — before dropping
      you back in Park City around 9:00&nbsp;PM. The meetup spot and the exact
      location are shared after you book.
    </p>
    <ul class="dr-flow">
      {eveningFlow.map((f) => (
        <li>
          <strong>{f.time}</strong>
          <span>{f.label}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="section-rule">
    <div class="dr-widget" id="dr-widget">
      <div id="dr-body"></div>
      <p class="dr-demo-note" id="dr-demo-note"></p>
    </div>
  </section>

  <section class="section-rule" id="dr-mine-section">
    <div class="dr-mine-head" id="dr-mine-head"></div>
    <div id="dr-mine-body"></div>
  </section>
</BaseLayout>

<script
  is:inline
  type="application/json"
  id="dr-initial-data"
  set:html={JSON.stringify({ year: initialYear, month: initialMonth, nights: initialNights })}
/>

<script>
  // ---------------------------------------------------------------------------
  // BYAH dinner reservations.
  //
  // Reservations live in Postgres (see src/lib/dinner-reservations-store.ts) -
  // this island only renders state and talks to /api/dinner-reservations/*.
  // There's still no login: a guest is just whatever email they book with,
  // same trust model as /beernbbq's rater name. The payment step is a
  // clearly-labeled stub - nothing is charged and no card data ever leaves
  // this page (it's never even sent to our server, let alone a processor).
  // ---------------------------------------------------------------------------

  import { getStoredGuestEmail, setStoredGuestEmail, clearStoredGuestEmail } from "../lib/dinner-guest";
  import {
    CAPACITY,
    PRICE_PER_GUEST,
    dateKey,
    esc,
    fmtLong,
    fmtShort,
    guestEmailHeader,
    isDateKey,
    isValidEmail,
    maxLeadNameLength,
    maxNoteLength,
    money,
    monthLabel,
    parseKey,
    type NightAvailability,
    type ReservationDTO
  } from "../lib/dinner-reservations";

  function $<T extends HTMLElement = HTMLElement>(id: string): T {
    const el = document.getElementById(id);
    if (!el) throw new Error(`missing element #${id}`);
    return el as T;
  }

  const now = new Date();
  const todayKey = dateKey(now);

  // --- initial data (rendered server-side, avoids a loading flash) -----------

  function readInitialData(): { year: number; month: number; nights: NightAvailability[] } {
    const fallback = { year: now.getFullYear(), month: now.getMonth(), nights: [] };
    const el = document.getElementById("dr-initial-data");
    if (!el?.textContent) return fallback;
    try {
      return JSON.parse(el.textContent);
    } catch {
      return fallback;
    }
  }

  const initial = readInitialData();

  // --- availability (server-backed, cached per calendar month) ---------------

  const monthCache = new Map<string, NightAvailability[]>();
  let currentByDate = new Map<string, NightAvailability>();
  let calendarLoading = false;
  let calendarError = "";

  function monthCacheKey(year: number, month: number): string {
    return `${year}-${month}`;
  }

  function setCurrentAvailability(nights: NightAvailability[]): void {
    currentByDate = new Map(nights.map((n) => [n.date, n]));
  }

  function leftFor(date: string): number {
    const n = currentByDate.get(date);
    return (n?.capacity ?? CAPACITY) - (n?.bookedSeats ?? 0);
  }

  function invalidateAvailabilityCache(): void {
    monthCache.clear();
  }

  async function loadMonth(year: number, month: number): Promise<void> {
    const key = monthCacheKey(year, month);
    const isCurrent = () => monthCacheKey(view.year, view.month) === key;

    const cached = monthCache.get(key);
    if (cached) {
      if (isCurrent()) {
        setCurrentAvailability(cached);
        calendarLoading = false;
        calendarError = "";
        renderBody();
      }
      return;
    }

    try {
      const res = await fetch(`/api/dinner-reservations/availability?year=${year}&month=${month}`);
      if (!res.ok) throw new Error("bad status");
      const data = (await res.json()) as { nights: NightAvailability[] };
      monthCache.set(key, data.nights);
      if (isCurrent()) {
        setCurrentAvailability(data.nights);
        calendarLoading = false;
        calendarError = "";
        renderBody();
      }
    } catch {
      if (isCurrent()) {
        calendarLoading = false;
        calendarError = "Couldn't load this month's availability. Check your connection and try again.";
        renderBody();
      }
    }
  }

  // --- wizard state ------------------------------------------------------

  type Step = "calendar" | "details" | "payment" | "done";

  let step: Step = "calendar";
  let selected: string | null = null;
  let partySize = 2;
  let draft = { leadName: "", email: "", note: "" };
  let card = { holder: "", number: "", expiry: "", cvc: "" };
  let error = "";
  let lastReservation: ReservationDTO | null = null;

  let view = { year: initial.year, month: initial.month };
  monthCache.set(monthCacheKey(view.year, view.month), initial.nights);
  setCurrentAvailability(initial.nights);

  // --- "my reservations" state --------------------------------------------

  let mineEmail: string | null = getStoredGuestEmail();
  let mineList: ReservationDTO[] | null = null;
  let mineLoading = false;
  let mineError = "";
  let pendingCancelId: string | null = null;
  let cancelling = false;
  let cancelError = "";

  // --- tiny HTML helpers ---------------------------------------------------

  function stepsRail(): string {
    const labels: [Step, string][] = [
      ["calendar", "1 · Date"],
      ["details", "2 · Details"],
      ["payment", "3 · Checkout"]
    ];
    return `<div class="dr-steps" role="list" aria-label="Booking progress">${labels
      .map(
        ([s, label]) =>
          `<span role="listitem" class="dr-step${step === s ? " dr-step--active" : ""}" data-step-label="${s}">${label}</span>`
      )
      .join("")}</div>`;
  }

  function changeDateLink(): string {
    return `<p class="dr-change-date"><button type="button" class="dr-link-btn" data-action="change-date">← Change date</button></p>`;
  }

  function backToDetailsLink(): string {
    return `<p class="dr-change-date"><button type="button" class="dr-link-btn" data-action="back-to-details">← Back to details</button></p>`;
  }

  // --- calendar step -----------------------------------------------------

  function renderCalendarPanel(): string {
    const prevDisabled = view.year === now.getFullYear() && view.month === now.getMonth();
    const nav = `
      <div class="dr-cal-nav">
        <button type="button" class="dr-cal-arrow" data-action="prev-month" aria-label="Previous month" ${prevDisabled ? "disabled" : ""}>‹</button>
        <span class="dr-cal-month">${monthLabel(view.year, view.month)}</span>
        <button type="button" class="dr-cal-arrow" data-action="next-month" aria-label="Next month">›</button>
      </div>
      <div class="dr-weekdays" aria-hidden="true">
        ${["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"].map((d) => `<span>${d}</span>`).join("")}
      </div>
    `;

    if (calendarLoading) {
      return `${stepsRail()}<div class="dr-cal">${nav}<div class="dr-cal-status" role="status">Loading availability…</div></div>`;
    }
    if (calendarError) {
      return `${stepsRail()}<div class="dr-cal">${nav}<div class="dr-cal-status dr-cal-status--error" role="alert">
        <p>${esc(calendarError)}</p>
        <button type="button" class="dr-btn" data-action="retry-calendar">Try again</button>
      </div></div>`;
    }

    const first = new Date(view.year, view.month, 1);
    const offset = first.getDay();
    const daysInMonth = new Date(view.year, view.month + 1, 0).getDate();

    let cells = "";
    for (let i = 0; i < offset; i++) {
      cells += `<span class="dr-cell dr-cell--empty" aria-hidden="true"></span>`;
    }
    for (let day = 1; day <= daysInMonth; day++) {
      const key = dateKey(new Date(view.year, view.month, day));
      const isPast = key < todayKey;
      const left = leftFor(key);
      const full = left <= 0;
      const isToday = key === todayKey;
      const isSelected = key === selected;

      let label: string;
      if (isPast) label = "past";
      else if (full) label = "full";
      else label = `${left} ${left === 1 ? "seat" : "seats"} left`;

      cells += `<button
        type="button"
        class="dr-cell${isSelected ? " dr-cell--selected" : ""}${isToday ? " dr-cell--today" : ""}"
        data-action="pick-date"
        data-date="${key}"
        aria-label="${fmtShort(key)} — ${label}"
        ${isPast || full ? "disabled" : ""}
      >
        <span class="dr-cell-day">${day}</span>
        <span class="dr-cell-left">${isPast ? "" : label}</span>
      </button>`;
    }

    const hint = selected
      ? `<div class="dr-calselect">
          <span>Selected: <strong>${fmtLong(selected)}</strong> — ${leftFor(selected)} of ${CAPACITY} seats still open.</span>
        </div>`
      : `<p class="dr-calselect dr-calselect--idle">Pick any open night below to start your reservation. Up to ${CAPACITY} guests per night.</p>`;

    return `
      ${stepsRail()}
      <div class="dr-cal">
        ${nav}
        <div class="dr-grid">${cells}</div>
      </div>
      <div class="dr-legend"><span class="dr-legend-dot dr-legend-dot--open"></span> open &nbsp;·&nbsp; <span class="dr-legend-dot dr-legend-dot--full"></span> full</div>
      ${hint}
    `;
  }

  // --- details step --------------------------------------------------------

  function renderDetailsPanel(): string {
    if (!selected) {
      step = "calendar";
      return renderCalendarPanel();
    }
    const left = leftFor(selected);
    const subtotal = partySize * PRICE_PER_GUEST;

    const errorHtml = error ? `<p class="dr-error" role="alert">${esc(error)}</p>` : "";

    return `
      ${stepsRail()}
      <div class="dr-panel">
        <p class="dr-date-line"><strong>${fmtLong(selected)}</strong> · ${left} of ${CAPACITY} seats left</p>
        ${changeDateLink()}

        <div class="dr-field">
          <label for="dr-party">Party size <span class="dr-required">*</span></label>
          <div class="dr-stepper">
            <button type="button" class="dr-step-btn" data-action="party-delta" data-delta="-1" aria-label="Fewer guests" ${partySize <= 1 ? "disabled" : ""}>−</button>
            <output id="dr-party" class="dr-party-out">${partySize}</output>
            <button type="button" class="dr-step-btn" data-action="party-delta" data-delta="1" aria-label="More guests" ${partySize >= left ? "disabled" : ""}>+</button>
          </div>
          <p class="dr-field-hint">${partySize >= left ? "That fills the night — nice." : `You can add up to ${left - partySize} more.`}</p>
        </div>

        <form id="dr-details-form" novalidate>
          <div class="dr-field">
            <label for="dr-name">Lead guest name <span class="dr-required">*</span></label>
            <input id="dr-name" name="leadName" type="text" autocomplete="name" maxlength="${maxLeadNameLength}" value="${esc(draft.leadName)}" placeholder="Name for the reservation" />
          </div>
          <div class="dr-field">
            <label for="dr-email">Email <span class="dr-required">*</span></label>
            <input id="dr-email" name="email" type="email" autocomplete="email" value="${esc(draft.email)}" placeholder="you@example.com" />
            <p class="dr-field-hint">Where we'd send your reservation details, and what you'll use to look it up later.</p>
          </div>
          <div class="dr-field">
            <label for="dr-note">Anything we should know? <span class="dr-optional">optional</span></label>
            <textarea id="dr-note" name="note" rows="3" maxlength="${maxNoteLength}" placeholder="Allergies, questions, a birthday…">${esc(draft.note)}</textarea>
          </div>
          ${errorHtml}
          <div class="dr-submit-row">
            <span class="dr-subtotal">${partySize} ${partySize === 1 ? "guest" : "guests"} · ${money.format(subtotal)}</span>
            <button type="submit" class="dr-btn dr-btn--primary">Continue to checkout →</button>
          </div>
        </form>
      </div>
    `;
  }

  // --- payment step (stub) ---------------------------------------------------

  function renderPaymentPanel(): string {
    if (!selected) {
      step = "calendar";
      return renderCalendarPanel();
    }
    const left = leftFor(selected);
    const total = partySize * PRICE_PER_GUEST;

    const errorHtml = error ? `<p class="dr-error" role="alert">${esc(error)}</p>` : "";

    return `
      ${stepsRail()}
      <div class="dr-panel">
        <p class="dr-date-line"><strong>${fmtLong(selected)}</strong> · ${left} of ${CAPACITY} seats left</p>
        ${backToDetailsLink()}

        <div class="dr-demo-banner" role="note">
          <strong>Demo checkout.</strong> This payment form is a stub — no card is
          charged and nothing is sent anywhere. The reservation itself is real.
        </div>

        <div class="dr-summary">
          <div class="dr-summary-row"><span>${partySize} ${partySize === 1 ? "guest" : "guests"} × ${money.format(PRICE_PER_GUEST)}</span><span>${money.format(total)}</span></div>
          <div class="dr-summary-row dr-summary-row--total"><span>Total</span><span>${money.format(total)}</span></div>
        </div>

        <form id="dr-pay-form" novalidate>
          <div class="dr-field">
            <label for="card-holder">Name on card</label>
            <input id="card-holder" type="text" autocomplete="cc-name" value="${esc(card.holder)}" placeholder="Full name" />
          </div>
          <div class="dr-field">
            <label for="card-number">Card number</label>
            <input id="card-number" type="text" inputmode="numeric" autocomplete="cc-number" value="${esc(card.number)}" placeholder="0000 0000 0000 0000" />
          </div>
          <div class="dr-field-row">
            <div class="dr-field">
              <label for="card-expiry">Expiry</label>
              <input id="card-expiry" type="text" inputmode="numeric" autocomplete="cc-exp" value="${esc(card.expiry)}" placeholder="MM/YY" />
            </div>
            <div class="dr-field">
              <label for="card-cvc">CVC</label>
              <input id="card-cvc" type="text" inputmode="numeric" autocomplete="cc-csc" value="${esc(card.cvc)}" placeholder="123" />
            </div>
          </div>
          ${errorHtml}
          <div class="dr-submit-row">
            <span class="dr-subtotal">Due today: ${money.format(total)}</span>
            <button type="submit" class="dr-btn dr-btn--primary" id="dr-pay-btn">Reserve for ${money.format(total)}</button>
          </div>
        </form>
      </div>
    `;
  }

  // --- confirmation step -----------------------------------------------------

  function renderDonePanel(): string {
    const r = lastReservation;
    if (!r) {
      step = "calendar";
      return renderCalendarPanel();
    }
    return `
      ${stepsRail()}
      <div class="dr-panel dr-panel--done">
        <p class="dr-check">✓</p>
        <h2>You're booked${r.leadName ? `, ${esc(r.leadName.split(" ")[0])}` : ""}!</h2>
        <p class="dr-code">Reservation code: <strong>${esc(r.code)}</strong></p>
        <ul class="dr-done-list">
          <li><strong>${fmtLong(r.date)}</strong></li>
          <li>${r.partySize} ${r.partySize === 1 ? "guest" : "guests"}</li>
          <li>Meet at 4:00 PM in Park City · back ~9:00 PM</li>
        </ul>
        <p class="dr-done-note">In the real version this confirmation would be emailed to ${esc(r.email)} along with the meetup spot. For now, look it up any time under "My reservations" below.</p>
        <div class="dr-done-actions">
          <button type="button" class="dr-btn" data-action="goto-reservations">View my reservations</button>
          <button type="button" class="dr-btn dr-btn--primary" data-action="book-another">Book another night →</button>
        </div>
      </div>
    `;
  }

  // --- rendering -------------------------------------------------------------

  function renderBody(): void {
    // A cancellation (or another booking) can shrink a night's remaining seats
    // mid-flow — clamp the party size, or bounce back to the calendar when the
    // night has filled up entirely.
    if ((step === "details" || step === "payment") && selected) {
      const left = leftFor(selected);
      if (left <= 0) {
        selected = null;
        step = "calendar";
      } else if (partySize > left) {
        partySize = left;
      }
    }

    const body = $("dr-body");
    if (step === "calendar") body.innerHTML = renderCalendarPanel();
    else if (step === "details") body.innerHTML = renderDetailsPanel();
    else if (step === "payment") body.innerHTML = renderPaymentPanel();
    else body.innerHTML = renderDonePanel();

    const note = $("dr-demo-note");
    note.textContent =
      step === "payment"
        ? "Demo checkout: no payment is processed. The reservation itself is saved for real."
        : "";
  }

  function renderAll(): void {
    renderBody();
    renderMine();
  }

  // --- "my reservations" rendering -----------------------------------------

  function renderMine(): void {
    const head = $("dr-mine-head");
    const body = $("dr-mine-body");

    head.innerHTML = `
      <h2>${mineList ? `My reservations (${mineList.length})` : "My reservations"}</h2>
      ${mineEmail ? `<button type="button" class="dr-link-btn" data-action="forget-me">Forget me on this device</button>` : ""}
    `;

    if (mineLoading) {
      body.innerHTML = `<p class="dr-mine-status">Loading your reservations…</p>`;
      return;
    }

    if (!mineEmail) {
      body.innerHTML = `
        <form id="dr-mine-lookup" class="dr-mine-lookup" novalidate>
          <label for="dr-mine-email">Look up your reservations by the email you booked with</label>
          <div class="dr-mine-lookup-row">
            <input id="dr-mine-email" type="email" placeholder="you@example.com" required />
            <button type="submit" class="dr-btn">Find</button>
          </div>
          ${mineError ? `<p class="dr-error" role="alert">${esc(mineError)}</p>` : ""}
        </form>
      `;
      return;
    }

    if (mineError) {
      body.innerHTML = `
        <p class="dr-error" role="alert">${esc(mineError)}</p>
        <p><button type="button" class="dr-link-btn" data-action="change-mine-email">Look up a different email</button></p>
      `;
      return;
    }

    const list = mineList ?? [];
    const items = list.length
      ? list
          .map((r) => {
            if (r.cancelledAt) {
              return `
                <li class="dr-mine-item dr-mine-item--cancelled">
                  <div class="dr-mine-main">
                    <strong>${fmtLong(r.date)}</strong>
                    <span class="dr-mine-meta">${esc(r.code)} · ${r.partySize} ${r.partySize === 1 ? "guest" : "guests"} · Cancelled</span>
                  </div>
                </li>`;
            }
            if (r.id === pendingCancelId) {
              return `
                <li class="dr-mine-item dr-mine-item--confirm">
                  <div class="dr-mine-main">
                    <strong>${fmtLong(r.date)}</strong>
                    <span class="dr-mine-meta">Cancel this reservation? This can't be undone.</span>
                  </div>
                  <span class="dr-mine-confirm-actions">
                    <button type="button" class="dr-link-btn" data-action="confirm-cancel" data-id="${esc(r.id)}" ${cancelling ? "disabled" : ""}>${cancelling ? "Cancelling…" : "Yes, cancel"}</button>
                    <button type="button" class="dr-link-btn" data-action="dismiss-cancel" ${cancelling ? "disabled" : ""}>Never mind</button>
                  </span>
                </li>`;
            }
            return `
              <li class="dr-mine-item">
                <div class="dr-mine-main">
                  <strong>${fmtLong(r.date)}</strong>
                  <span class="dr-mine-meta">${esc(r.code)} · ${r.partySize} ${r.partySize === 1 ? "guest" : "guests"} · ${esc(r.leadName || "—")}</span>
                </div>
                <button type="button" class="dr-link-btn" data-action="cancel-reservation" data-id="${esc(r.id)}">Cancel</button>
              </li>`;
          })
          .join("")
      : `<li class="dr-mine-empty">No reservations yet — pick an open night above.</li>`;

    body.innerHTML = `
      ${cancelError ? `<p class="dr-error" role="alert">${esc(cancelError)}</p>` : ""}
      <ul class="dr-mine">${items}</ul>
      <p class="dr-mine-switch"><button type="button" class="dr-link-btn" data-action="change-mine-email">Not ${esc(mineEmail)}? Look up a different email</button></p>
    `;
  }

  async function loadMine(email: string): Promise<void> {
    mineLoading = true;
    mineError = "";
    renderMine();
    try {
      const res = await fetch("/api/dinner-reservations/mine", {
        headers: { [guestEmailHeader]: email }
      });
      if (!res.ok) throw new Error("bad status");
      const data = (await res.json()) as { reservations: ReservationDTO[] };
      mineList = data.reservations;
      mineEmail = email;
      setStoredGuestEmail(email);
    } catch {
      mineError = "Couldn't load your reservations. Check the email and try again.";
      mineList = null;
    } finally {
      mineLoading = false;
      renderMine();
    }
  }

  function forgetMe(): void {
    clearStoredGuestEmail();
    mineEmail = null;
    mineList = null;
    mineError = "";
    pendingCancelId = null;
    cancelError = "";
    renderMine();
  }

  // --- input formatting helpers (card fields only) ----------------------------

  function digits(s: string): string {
    return s.replace(/\D/g, "");
  }

  function formatCardNumber(s: string): string {
    const d = digits(s).slice(0, 16);
    return d.replace(/(\d{4})(?=\d)/g, "$1 ");
  }

  function formatExpiry(s: string): string {
    const d = digits(s).slice(0, 4);
    if (d.length <= 2) return d;
    return `${d.slice(0, 2)}/${d.slice(2)}`;
  }

  // --- validation ------------------------------------------------------------

  function validateDetails(): string {
    if (!draft.leadName.trim()) return "Please add the lead guest's name.";
    if (!isValidEmail(draft.email)) return "Please add a valid email address.";
    if (partySize < 1) return "Party size must be at least 1.";
    if (selected && partySize > leftFor(selected))
      return "That party is bigger than the seats left that night.";
    return "";
  }

  function validateCard(): string {
    if (!card.holder.trim()) return "Please add the name on the card.";
    const num = digits(card.number);
    if (num.length < 15 || num.length > 16) return "Card number should be 15–16 digits.";
    const exp = digits(card.expiry);
    if (exp.length !== 4) return "Expiry should be MM/YY.";
    const mm = Number(exp.slice(0, 2));
    const yy = Number(exp.slice(2));
    const nowYy = now.getFullYear() % 100;
    if (mm < 1 || mm > 12) return "Expiry month should be 01–12.";
    if (yy < nowYy || (yy === nowYy && mm < now.getMonth() + 1)) return "That card has expired.";
    const cvc = digits(card.cvc);
    if (cvc.length < 3 || cvc.length > 4) return "CVC should be 3–4 digits.";
    return "";
  }

  // --- actions ---------------------------------------------------------------

  function pickDate(key: string): void {
    if (key < todayKey || leftFor(key) <= 0) return;
    selected = key;
    const left = leftFor(key);
    partySize = Math.min(Math.max(partySize, 1), left);
    draft = { leadName: "", email: mineEmail ?? "", note: "" };
    card = { holder: "", number: "", expiry: "", cvc: "" };
    error = "";
    step = "details";
    renderAll();
    $("dr-widget").scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function changeDate(): void {
    if (selected) {
      const d = parseKey(selected);
      view = { year: d.getFullYear(), month: d.getMonth() };
    }
    error = "";
    step = "calendar";
    renderAll();
  }

  function backToDetails(): void {
    error = "";
    step = "details";
    renderAll();
  }

  function submitDetails(): void {
    error = validateDetails();
    if (error) {
      renderAll();
      return;
    }
    error = "";
    step = "payment";
    renderAll();
    $("dr-widget").scrollIntoView({ behavior: "smooth", block: "start" });
  }

  async function submitPayment(): Promise<void> {
    if (!selected) return;
    if (partySize > leftFor(selected)) {
      error = "Sorry — that night's remaining seats changed. Pick again.";
      step = "details";
      renderAll();
      return;
    }
    error = validateCard();
    if (error) {
      renderAll();
      return;
    }

    const btn = $<HTMLButtonElement>("dr-pay-btn");
    btn.disabled = true;
    btn.textContent = "Reserving…";

    try {
      const res = await fetch("/api/dinner-reservations", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          date: selected,
          partySize,
          leadName: draft.leadName,
          email: draft.email,
          note: draft.note
        })
      });

      if (res.status === 409) {
        invalidateAvailabilityCache();
        error = "Sorry — that night's remaining seats changed. Pick again.";
        step = "details";
        renderAll();
        return;
      }
      if (!res.ok) {
        const body = await res.json().catch(() => null);
        error = body?.error ?? "Something went wrong. Please try again.";
        renderAll();
        return;
      }

      const reservation = (await res.json()) as ReservationDTO;
      lastReservation = reservation;
      invalidateAvailabilityCache();
      step = "done";
      renderAll();
      $("dr-widget").scrollIntoView({ behavior: "smooth", block: "start" });
      void loadMine(reservation.email);
    } catch {
      error = "Network error — check your connection and try again.";
      renderAll();
    }
  }

  function requestCancel(id: string): void {
    pendingCancelId = id;
    cancelError = "";
    renderMine();
  }

  function dismissCancel(): void {
    pendingCancelId = null;
    renderMine();
  }

  async function confirmCancel(id: string): Promise<void> {
    if (!mineEmail) return;

    cancelling = true;
    renderMine();

    try {
      const res = await fetch(`/api/dinner-reservations/${id}`, {
        method: "DELETE",
        headers: { [guestEmailHeader]: mineEmail }
      });
      if (!res.ok) {
        const body = await res.json().catch(() => null);
        cancelError = body?.error ?? "Couldn't cancel that reservation.";
        pendingCancelId = null;
        cancelling = false;
        renderMine();
        return;
      }
      if (lastReservation?.id === id) lastReservation = null;
      invalidateAvailabilityCache();
      pendingCancelId = null;
      cancelling = false;
      cancelError = "";
      await loadMine(mineEmail);
      if (step === "calendar") {
        calendarLoading = true;
        renderBody();
        void loadMonth(view.year, view.month);
      }
    } catch {
      cancelError = "Network error — couldn't cancel that reservation.";
      pendingCancelId = null;
      cancelling = false;
      renderMine();
    }
  }

  function bookAnother(): void {
    selected = null;
    partySize = 2;
    draft = { leadName: "", email: "", note: "" };
    card = { holder: "", number: "", expiry: "", cvc: "" };
    error = "";
    view = { year: now.getFullYear(), month: now.getMonth() };
    step = "calendar";
    calendarLoading = true;
    renderAll();
    void loadMonth(view.year, view.month);
    $("dr-widget").scrollIntoView({ behavior: "smooth", block: "start" });
  }

  // --- event wiring (bound once - re-binding on every render double-fires
  // actions, since #dr-body itself is never replaced, only its children) -----

  function initBodyEvents(): void {
    const body = $("dr-body");

    body.addEventListener("click", (ev) => {
      const target = (ev.target as HTMLElement).closest<HTMLElement>("[data-action]");
      if (!target) return;
      const action = target.dataset.action;
      const date = target.dataset.date;

      if (action === "prev-month") {
        if (view.year === now.getFullYear() && view.month === now.getMonth()) return;
        view = view.month === 0 ? { year: view.year - 1, month: 11 } : { year: view.year, month: view.month - 1 };
        calendarLoading = true;
        renderBody();
        void loadMonth(view.year, view.month);
      } else if (action === "next-month") {
        view = view.month === 11 ? { year: view.year + 1, month: 0 } : { year: view.year, month: view.month + 1 };
        calendarLoading = true;
        renderBody();
        void loadMonth(view.year, view.month);
      } else if (action === "retry-calendar") {
        calendarLoading = true;
        renderBody();
        void loadMonth(view.year, view.month);
      } else if (action === "pick-date" && date) {
        pickDate(date);
      } else if (action === "change-date") {
        changeDate();
      } else if (action === "back-to-details") {
        backToDetails();
      } else if (action === "party-delta" && target.dataset.delta) {
        const delta = Number(target.dataset.delta);
        const max = selected ? leftFor(selected) : CAPACITY;
        const next = Math.min(Math.max(partySize + delta, 1), max);
        if (next !== partySize) {
          partySize = next;
          renderBody();
        }
      } else if (action === "goto-reservations") {
        $("dr-mine-section").scrollIntoView({ behavior: "smooth", block: "start" });
      } else if (action === "book-another") {
        bookAnother();
      }
    });

    body.addEventListener("submit", (ev) => {
      const form = ev.target as HTMLFormElement;
      if (form.id === "dr-details-form") {
        ev.preventDefault();
        const name = (form.elements.namedItem("leadName") as HTMLInputElement)?.value ?? "";
        const email = (form.elements.namedItem("email") as HTMLInputElement)?.value ?? "";
        const note = (form.elements.namedItem("note") as HTMLTextAreaElement)?.value ?? "";
        draft = { leadName: name, email, note };
        submitDetails();
      } else if (form.id === "dr-pay-form") {
        ev.preventDefault();
        void submitPayment();
      }
    });

    body.addEventListener("input", (ev) => {
      const el = ev.target as HTMLInputElement;
      if (el.id === "card-holder") {
        card.holder = el.value;
      } else if (el.id === "card-number") {
        const formatted = formatCardNumber(el.value);
        if (el.value !== formatted) el.value = formatted;
        card.number = formatted;
      } else if (el.id === "card-expiry") {
        const formatted = formatExpiry(el.value);
        if (el.value !== formatted) el.value = formatted;
        card.expiry = formatted;
      } else if (el.id === "card-cvc") {
        const d = digits(el.value).slice(0, 4);
        if (el.value !== d) el.value = d;
        card.cvc = d;
      }
    });
  }

  function initMineEvents(): void {
    const section = $("dr-mine-section");

    section.addEventListener("click", (ev) => {
      const target = (ev.target as HTMLElement).closest<HTMLElement>("[data-action]");
      if (!target) return;
      const action = target.dataset.action;

      if (action === "forget-me") {
        forgetMe();
      } else if (action === "change-mine-email") {
        mineEmail = null;
        mineList = null;
        mineError = "";
        pendingCancelId = null;
        cancelError = "";
        clearStoredGuestEmail();
        renderMine();
      } else if (action === "cancel-reservation" && target.dataset.id) {
        requestCancel(target.dataset.id);
      } else if (action === "confirm-cancel" && target.dataset.id) {
        void confirmCancel(target.dataset.id);
      } else if (action === "dismiss-cancel") {
        dismissCancel();
      }
    });

    section.addEventListener("submit", (ev) => {
      const form = ev.target as HTMLFormElement;
      if (form.id !== "dr-mine-lookup") return;
      ev.preventDefault();
      const input = form.querySelector<HTMLInputElement>("#dr-mine-email");
      const email = input?.value.trim() ?? "";
      if (!isValidEmail(email)) {
        mineError = "Please enter a valid email address.";
        renderMine();
        return;
      }
      void loadMine(email);
    });
  }

  // --- init ------------------------------------------------------------------

  function init(): void {
    initBodyEvents();
    initMineEvents();

    // Support deep-linking: /dinner-reservations?date=YYYY-MM-DD
    const params = new URLSearchParams(window.location.search);
    const dateParam = params.get("date");
    if (isDateKey(dateParam) && dateParam >= todayKey) {
      const d = parseKey(dateParam);
      view = { year: d.getFullYear(), month: d.getMonth() };
    }

    renderAll();
    if (monthCacheKey(view.year, view.month) !== monthCacheKey(initial.year, initial.month)) {
      calendarLoading = true;
      renderBody();
      void loadMonth(view.year, view.month);
    }

    if (mineEmail) void loadMine(mineEmail);
    else renderMine();
  }

  init();
</script>

