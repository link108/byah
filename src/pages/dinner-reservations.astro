---
import BaseLayout from "../layouts/BaseLayout.astro";

const eveningFlow = [
  { time: "4:00 PM", label: "Meet in Park City" },
  { time: "4:30 PM", label: "Shuttle to the private location" },
  { time: "Evening", label: "Activities, then dinner + drinks" },
  { time: "~9:00 PM", label: "Back in Park City" }
];
---

<BaseLayout
  title="Dinner Reservations"
  description="Reserve a seat at a BYAH dinner night in Park City — up to 24 guests. Pick a date, tell us who's coming, and check out."
  currentPath="/dinner-reservations"
>
  <section>
    <span class="eyebrow">BYAH dinner nights · Park City</span>
    <h1>Dinner Reservations</h1>
    <p class="content-body">
      A private dinner night runs most evenings with up to 24 guests: we meet at
      4:00&nbsp;PM in Park City, drive you to a private location nearby, and
      take care of the rest — activities, dinner, and drinks — before dropping
      you back in Park City around 9:00&nbsp;PM. The meetup spot and the exact
      location are shared after you book.
    </p>
    <ul class="dr-flow">
      {eveningFlow.map((f) => (
        <li>
          <strong>{f.time}</strong>
          <span>{f.label}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="section-rule">
    <div class="dr-widget" id="dr-widget">
      <div id="dr-body"></div>
      <p class="dr-demo-note" id="dr-demo-note"></p>
    </div>
  </section>

  <section class="section-rule" id="dr-mine-section">
    <div class="dr-mine-head">
      <h2 id="dr-mine-title">My reservations</h2>
    </div>
    <p class="dr-mine-hint">Enter the email you booked with to see and cancel your reservations.</p>
    <form id="dr-lookup-form" class="dr-lookup" novalidate>
      <input id="dr-lookup-email" type="email" autocomplete="email" placeholder="you@example.com" aria-label="Email used to book" />
      <button type="submit" class="dr-btn">Look up</button>
    </form>
    <p class="dr-mine-status" id="dr-mine-status" role="status" aria-live="polite"></p>
    <ul class="dr-mine" id="dr-mine"></ul>
  </section>
</BaseLayout>

<script>
  // ---------------------------------------------------------------------------
  // BYAH dinner reservations — Postgres-backed booking flow.
  //
  // Availability and bookings live in the byah Postgres database behind
  // /api/dinner-reservations (the same Prisma wiring as the /beernbbq pages),
  // so seat counts are shared across every visitor, not per browser. The
  // checkout step is a clearly-labeled demo stub: confirming creates the
  // booking server-side and lands you on a confirmation page — no card is
  // collected and nothing is charged. Identity for "my reservations" is the
  // email you booked with (same friend-group trust model as beernbbq's rater
  // name).
  // ---------------------------------------------------------------------------

  const CAPACITY = 24;
  // TODO(cameron): set the real per-guest price before launch.
  const PRICE_PER_GUEST = 175;
  const EMAIL_KEY = "byah.dinner.email";

  const money = new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD"
  });

  type Reservation = {
    id: string;
    date: string; // local yyyy-mm-dd
    code: string;
    partySize: number;
    leadName: string;
    email: string;
    note: string | null;
    createdAt: string;
    cancelledAt: string | null;
  };

  type Availability = {
    month: string;
    capacity: number;
    days: Record<string, number>; // date -> seats taken
  };

  class ApiError extends Error {
    status: number;
    constructor(status: number, message: string) {
      super(message);
      this.status = status;
    }
  }

  async function api<T>(path: string, init?: RequestInit): Promise<T> {
    const res = await fetch(path, init);
    if (!res.ok) {
      let message = `Request failed (${res.status})`;
      try {
        const body = (await res.json()) as { error?: string };
        if (body?.error) message = body.error;
      } catch {
        // keep the generic message
      }
      throw new ApiError(res.status, message);
    }
    return (await res.json()) as T;
  }

  function $<T extends HTMLElement = HTMLElement>(id: string): T {
    const el = document.getElementById(id);
    if (!el) throw new Error(`missing element #${id}`);
    return el as T;
  }

  function maybe<T extends HTMLElement>(id: string): T | null {
    return document.getElementById(id) as T | null;
  }

  // Escape user content rendered into HTML strings.
  function esc(s: string): string {
    return s.replace(
      /[&<>"']/g,
      (c) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[
          c
        ] ?? c
    );
  }

  // --- date helpers (all local-time, no UTC round-trips) ---------------------

  function pad(n: number): string {
    return String(n).padStart(2, "0");
  }

  function dateKey(d: Date): string {
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
  }

  function parseKey(key: string): Date {
    const [y, m, d] = key.split("-").map(Number);
    return new Date(y, m - 1, d);
  }

  const now = new Date();
  const todayKey = dateKey(now);

  function monthKeyOf(year: number, month: number): string {
    return `${year}-${pad(month + 1)}`;
  }

  function monthLabel(year: number, month: number): string {
    return new Date(year, month, 1).toLocaleDateString("en-US", {
      month: "long",
      year: "numeric"
    });
  }

  function fmtLong(key: string): string {
    return parseKey(key).toLocaleDateString("en-US", {
      weekday: "long",
      month: "long",
      day: "numeric",
      year: "numeric"
    });
  }

  function fmtShort(key: string): string {
    return parseKey(key).toLocaleDateString("en-US", {
      weekday: "short",
      month: "short",
      day: "numeric"
    });
  }

  // --- availability (the server is the source of truth) ----------------------

  const availability = new Map<string, Record<string, number>>();
  const loading = new Set<string>();

  function takenFor(date: string): number | null {
    const days = availability.get(date.slice(0, 7));
    if (!days) return null;
    return days[date] ?? 0;
  }

  function leftFor(date: string): number | null {
    const taken = takenFor(date);
    return taken === null ? null : CAPACITY - taken;
  }

  async function loadMonth(year: number, month: number): Promise<void> {
    const key = monthKeyOf(year, month);
    if (loading.has(key) || availability.has(key)) return;
    loading.add(key);
    try {
      const data = await api<Availability>(
        `/api/dinner-reservations/availability?month=${encodeURIComponent(key)}`
      );
      availability.set(data.month, data.days ?? {});
      // The month may have loaded while the guest was mid-flow — only repaint
      // if they're still looking at the calendar for it.
      if (step === "calendar" && view.year === year && view.month === month) {
        renderBody();
      }
    } catch (err) {
      console.error("failed to load availability", err);
    } finally {
      loading.delete(key);
    }
  }

  function refreshMonth(year: number, month: number): void {
    availability.delete(monthKeyOf(year, month));
    void loadMonth(year, month);
  }

  // --- wizard state ----------------------------------------------------------

  type Step = "calendar" | "details" | "payment";

  let step: Step = "calendar";
  let selected: string | null = null;
  let partySize = 2;
  let draft = { leadName: "", email: "", note: "" };
  let error = "";
  let busy = false;
  let view = { year: now.getFullYear(), month: now.getMonth() };

  // --- tiny HTML helpers -----------------------------------------------------

  function stepsRail(): string {
    const labels: [Step, string][] = [
      ["calendar", "1 · Date"],
      ["details", "2 · Details"],
      ["payment", "3 · Checkout"]
    ];
    return `<div class="dr-steps" role="list" aria-label="Booking progress">${labels
      .map(
        ([s, label]) =>
          `<span role="listitem" class="dr-step${step === s ? " dr-step--active" : ""}" data-step-label="${s}">${label}</span>`
      )
      .join("")}</div>`;
  }

  function backLink(): string {
    return `<p class="dr-change-date"><button type="button" class="dr-link-btn" data-action="change-date">← Change date</button></p>`;
  }

  function errorHtml(): string {
    return error ? `<p class="dr-error" role="alert">${esc(error)}</p>` : "";
  }

  // --- calendar step ---------------------------------------------------------

  function renderCalendarPanel(): string {
    const first = new Date(view.year, view.month, 1);
    const offset = first.getDay();
    const daysInMonth = new Date(view.year, view.month + 1, 0).getDate();
    const prevDisabled =
      view.year === now.getFullYear() && view.month === now.getMonth();
    const monthReady = availability.has(monthKeyOf(view.year, view.month));

    let cells = "";
    for (let i = 0; i < offset; i++) {
      cells += `<span class="dr-cell dr-cell--empty" aria-hidden="true"></span>`;
    }
    for (let day = 1; day <= daysInMonth; day++) {
      const key = dateKey(new Date(view.year, view.month, day));
      const isPast = key < todayKey;
      const left = monthReady ? leftFor(key) : null;
      const full = left !== null && left <= 0;
      const isToday = key === todayKey;
      const isSelected = key === selected;

      let label: string;
      if (isPast) label = "past";
      else if (!monthReady) label = "…";
      else if (full) label = "full";
      else label = `${left} ${left === 1 ? "seat" : "seats"} left`;

      cells += `<button
        type="button"
        class="dr-cell${isSelected ? " dr-cell--selected" : ""}${isToday ? " dr-cell--today" : ""}"
        data-action="pick-date"
        data-date="${key}"
        aria-label="${fmtShort(key)} — ${label}"
        ${isPast || !monthReady || full ? "disabled" : ""}
      >
        <span class="dr-cell-day">${day}</span>
        <span class="dr-cell-left">${isPast ? "" : label}</span>
      </button>`;
    }

    const hint = selected
      ? `<div class="dr-calselect">
          <span>Selected: <strong>${fmtLong(selected)}</strong> — ${leftFor(selected)} of ${CAPACITY} seats still open.</span>
        </div>`
      : `<p class="dr-calselect dr-calselect--idle">Pick any open night below to start your reservation. Up to ${CAPACITY} guests per night.</p>`;

    return `
      ${stepsRail()}
      <div class="dr-cal">
        <div class="dr-cal-nav">
          <button type="button" class="dr-cal-arrow" data-action="prev-month" aria-label="Previous month" ${prevDisabled ? "disabled" : ""}>‹</button>
          <span class="dr-cal-month">${monthLabel(view.year, view.month)}</span>
          <button type="button" class="dr-cal-arrow" data-action="next-month" aria-label="Next month">›</button>
        </div>
        <div class="dr-weekdays" aria-hidden="true">
          ${["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"].map((d) => `<span>${d}</span>`).join("")}
        </div>
        <div class="dr-grid">${cells}</div>
      </div>
      <div class="dr-legend"><span class="dr-legend-dot dr-legend-dot--open"></span> open &nbsp;·&nbsp; <span class="dr-legend-dot dr-legend-dot--full"></span> full</div>
      ${errorHtml()}
      ${hint}
    `;
  }

  // --- details step ----------------------------------------------------------

  function renderDetailsPanel(): string {
    if (!selected) {
      step = "calendar";
      return renderCalendarPanel();
    }
    const left = leftFor(selected) ?? CAPACITY;
    const subtotal = partySize * PRICE_PER_GUEST;

    return `
      ${stepsRail()}
      <div class="dr-panel">
        <p class="dr-date-line"><strong>${fmtLong(selected)}</strong> · ${left} of ${CAPACITY} seats left</p>
        ${backLink()}

        <div class="dr-field">
          <label for="dr-party">Party size <span class="dr-required">*</span></label>
          <div class="dr-stepper">
            <button type="button" class="dr-step-btn" data-action="party-delta" data-delta="-1" aria-label="Fewer guests" ${partySize <= 1 ? "disabled" : ""}>−</button>
            <output id="dr-party" class="dr-party-out">${partySize}</output>
            <button type="button" class="dr-step-btn" data-action="party-delta" data-delta="1" aria-label="More guests" ${partySize >= left ? "disabled" : ""}>+</button>
          </div>
          <p class="dr-field-hint">${partySize >= left ? "That fills the night — nice." : `You can add up to ${left - partySize} more.`}</p>
        </div>

        <form id="dr-details-form" novalidate>
          <div class="dr-field">
            <label for="dr-name">Lead guest name <span class="dr-required">*</span></label>
            <input id="dr-name" type="text" autocomplete="name" value="${esc(draft.leadName)}" placeholder="Name for the reservation" />
          </div>
          <div class="dr-field">
            <label for="dr-email">Email <span class="dr-required">*</span></label>
            <input id="dr-email" type="email" autocomplete="email" value="${esc(draft.email)}" placeholder="you@example.com" />
            <p class="dr-field-hint">We'll use this to look up and manage your reservation.</p>
          </div>
          <div class="dr-field">
            <label for="dr-note">Anything we should know? <span class="dr-optional">optional</span></label>
            <textarea id="dr-note" rows="3" placeholder="Allergies, questions, a birthday…">${esc(draft.note)}</textarea>
          </div>
          ${errorHtml()}
          <div class="dr-submit-row">
            <span class="dr-subtotal">${partySize} ${partySize === 1 ? "guest" : "guests"} · ${money.format(subtotal)}</span>
            <button type="submit" class="dr-btn dr-btn--primary">Continue to checkout →</button>
          </div>
        </form>
      </div>
    `;
  }

  // --- checkout step (demo stub) ---------------------------------------------

  function renderPaymentPanel(): string {
    if (!selected) {
      step = "calendar";
      return renderCalendarPanel();
    }
    const left = leftFor(selected) ?? CAPACITY;
    const total = partySize * PRICE_PER_GUEST;

    return `
      ${stepsRail()}
      <div class="dr-panel">
        <p class="dr-date-line"><strong>${fmtLong(selected)}</strong> · ${left} of ${CAPACITY} seats left</p>
        ${backLink()}

        <div class="dr-demo-banner" role="note">
          <strong>Demo checkout.</strong> No card is collected and nothing is
          charged — confirming below books your seats and takes you to a
          confirmation page.
        </div>

        <div class="dr-summary">
          <div class="dr-summary-row"><span>${partySize} ${partySize === 1 ? "guest" : "guests"} × ${money.format(PRICE_PER_GUEST)}</span><span>${money.format(total)}</span></div>
          <div class="dr-summary-row dr-summary-row--total"><span>Total</span><span>${money.format(total)}</span></div>
        </div>

        ${errorHtml()}
        <div class="dr-submit-row">
          <span class="dr-subtotal">Due today: ${money.format(total)} · demo, no charge</span>
          <button type="button" class="dr-btn dr-btn--primary" id="dr-pay-btn" data-action="pay">Reserve for ${money.format(total)}</button>
        </div>
      </div>
    `;
  }

  // --- "my reservations" list (email lookup) ---------------------------------

  function mineEmail(): string {
    return (maybe<HTMLInputElement>("dr-lookup-email")?.value ?? "")
      .trim()
      .toLowerCase();
  }

  function renderMine(): void {
    const email = mineEmail();
    const title = $("dr-mine-title");
    const status = $("dr-mine-status");
    const ul = $("dr-mine");
    if (!email) {
      title.textContent = "My reservations";
      status.textContent = "";
      ul.innerHTML = `<li class="dr-mine-empty">Enter your email above to see your reservations.</li>`;
      return;
    }
    status.textContent = "Looking up…";
    api<{ reservations: Reservation[] }>(
      `/api/dinner-reservations?email=${encodeURIComponent(email)}`
    )
      .then((data) => {
        const list = data.reservations ?? [];
        title.textContent = list.length
          ? `My reservations (${list.length})`
          : "My reservations";
        status.textContent = list.length
          ? ""
          : `No reservations found for ${email}.`;
        if (!list.length) {
          ul.innerHTML = `<li class="dr-mine-empty">No reservations for ${esc(email)} yet — pick an open night above.</li>`;
          return;
        }
        ul.innerHTML = list
          .map(
            (r) => `
        <li class="dr-mine-item">
          <div class="dr-mine-main">
            <strong>${fmtLong(r.date)}</strong>
            <span class="dr-mine-meta">${esc(r.code)} · ${r.partySize} ${r.partySize === 1 ? "guest" : "guests"} · ${esc(r.leadName)}</span>
          </div>
          <button type="button" class="dr-link-btn" data-action="cancel-reservation" data-code="${esc(r.code)}">Cancel</button>
        </li>`
          )
          .join("");
      })
      .catch(() => {
        status.textContent = "Couldn't load reservations — try again in a moment.";
      });
  }

  // --- rendering -------------------------------------------------------------

  function renderBody(): void {
    if ((step === "details" || step === "payment") && selected) {
      const left = leftFor(selected);
      if (left === null) {
        refreshMonth(view.year, view.month);
      } else if (left <= 0) {
        // The night filled up while the guest sat on a later step.
        error = "That night just filled up — please pick another.";
        selected = null;
        step = "calendar";
      } else if (partySize > left) {
        partySize = left;
      }
    }

    const body = $("dr-body");
    if (step === "calendar") body.innerHTML = renderCalendarPanel();
    else if (step === "details") body.innerHTML = renderDetailsPanel();
    else body.innerHTML = renderPaymentPanel();

    const note = $("dr-demo-note");
    note.textContent =
      step === "payment"
        ? "Demo checkout: your seats are booked only when you confirm — no payment is processed."
        : "";

    bindPanel();
  }

  // --- actions ---------------------------------------------------------------

  function pickDate(key: string): void {
    if (key < todayKey) return;
    const left = leftFor(key);
    if (left === null || left <= 0) return;
    selected = key;
    partySize = Math.min(Math.max(partySize, 1), left);
    draft = { leadName: "", email: "", note: "" };
    error = "";
    step = "details";
    renderBody();
    $("dr-widget").scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function changeDate(): void {
    if (selected) {
      const d = parseKey(selected);
      view = { year: d.getFullYear(), month: d.getMonth() };
    }
    error = "";
    step = "calendar";
    renderBody();
  }

  function submitDetails(): void {
    const name = draft.leadName.trim();
    const email = draft.email.trim();
    if (!name) {
      error = "Please add the lead guest's name.";
      renderBody();
      return;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      error = "Please add a valid email address.";
      renderBody();
      return;
    }
    if (!selected || partySize < 1) {
      error = "Pick a date and party size first.";
      step = "calendar";
      renderBody();
      return;
    }
    const left = leftFor(selected);
    if (left !== null && partySize > left) {
      error = "That party is bigger than the seats left that night.";
      renderBody();
      return;
    }
    error = "";
    step = "payment";
    renderBody();
    $("dr-widget").scrollIntoView({ behavior: "smooth", block: "start" });
  }

  async function submitPayment(): Promise<void> {
    if (busy || !selected) return;
    const left = leftFor(selected);
    if (left === null || left <= 0) {
      error = "That night just filled up — please pick another.";
      selected = null;
      step = "calendar";
      renderBody();
      return;
    }
    busy = true;
    const btn = maybe<HTMLButtonElement>("dr-pay-btn");
    if (btn) {
      btn.disabled = true;
      btn.textContent = "Reserving…";
    }
    try {
      const data = await api<{ reservation: Reservation }>(
        "/api/dinner-reservations",
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            date: selected,
            partySize,
            leadName: draft.leadName.trim(),
            email: draft.email.trim(),
            note: draft.note.trim()
          })
        }
      );
      if (!data?.reservation?.code) throw new Error("no reservation returned");
      // Drop the cached month so the counts are fresh when they come back.
      availability.delete(selected.slice(0, 7));
      window.location.assign(
        `/dinner-reservations/confirmed?code=${encodeURIComponent(data.reservation.code)}`
      );
    } catch (err) {
      busy = false;
      const apiErr = err instanceof ApiError ? err : null;
      const msg = apiErr?.message ?? "Something went wrong — please try again.";
      if (apiErr && apiErr.status === 409) {
        error = `${msg} Pick another night.`;
        selected = null;
        step = "calendar";
        refreshMonth(view.year, view.month);
      } else if (apiErr && apiErr.status === 400) {
        error = msg;
        step = "details";
      } else {
        error = msg;
      }
      renderBody();
    }
  }

  async function cancelReservation(code: string): Promise<void> {
    const res = await api<{ reservation: Reservation }>(
      `/api/dinner-reservations?code=${encodeURIComponent(code)}`
    ).catch(() => null);
    const r = res?.reservation;
    if (
      !r ||
      !window.confirm(
        `Cancel the ${fmtShort(r.date)} reservation for ${r.partySize} ${
          r.partySize === 1 ? "guest" : "guests"
        }?`
      )
    ) {
      return;
    }
    try {
      await api<{ ok: boolean }>(
        `/api/dinner-reservations/${encodeURIComponent(code)}/cancel`,
        { method: "POST" }
      );
      // Seats are freed — refresh whatever availability is on screen.
      if (selected) availability.delete(selected.slice(0, 7));
      availability.delete(monthKeyOf(view.year, view.month));
      renderMine();
      renderBody();
      void loadMonth(view.year, view.month);
    } catch {
      $("dr-mine-status").textContent = "Couldn't cancel — try again in a moment.";
    }
  }

  // --- event wiring ----------------------------------------------------------

  function bindPanel(): void {
    const body = $("dr-body");

    body.addEventListener("click", (ev) => {
      const target = (ev.target as HTMLElement).closest<HTMLElement>(
        "[data-action]"
      );
      if (!target) return;
      const action = target.dataset.action;
      const date = target.dataset.date;

      if (action === "prev-month") {
        if (view.year === now.getFullYear() && view.month === now.getMonth())
          return;
        view =
          view.month === 0
            ? { year: view.year - 1, month: 11 }
            : { year: view.year, month: view.month - 1 };
        renderBody();
        void loadMonth(view.year, view.month);
      } else if (action === "next-month") {
        view =
          view.month === 11
            ? { year: view.year + 1, month: 0 }
            : { year: view.year, month: view.month + 1 };
        renderBody();
        void loadMonth(view.year, view.month);
      } else if (action === "pick-date" && date) {
        pickDate(date);
      } else if (action === "change-date") {
        changeDate();
      } else if (action === "party-delta" && target.dataset.delta) {
        const delta = Number(target.dataset.delta);
        const max = selected ? (leftFor(selected) ?? CAPACITY) : CAPACITY;
        const next = Math.min(Math.max(partySize + delta, 1), max);
        if (next !== partySize) {
          partySize = next;
          renderBody();
        }
      } else if (action === "pay") {
        void submitPayment();
      }
    });

    const detailsForm = maybe<HTMLFormElement>("dr-details-form");
    detailsForm?.addEventListener("submit", (ev) => {
      ev.preventDefault();
      const name = maybe<HTMLInputElement>("dr-name")?.value ?? "";
      const email = maybe<HTMLInputElement>("dr-email")?.value ?? "";
      const note = maybe<HTMLTextAreaElement>("dr-note")?.value ?? "";
      draft = { leadName: name, email, note };
      submitDetails();
    });
  }

  function bindMine(): void {
    $("dr-lookup-form").addEventListener("submit", (ev) => {
      ev.preventDefault();
      localStorage.setItem(EMAIL_KEY, mineEmail());
      renderMine();
    });

    $("dr-mine").addEventListener("click", (ev) => {
      const target = (ev.target as HTMLElement).closest<HTMLElement>(
        "[data-action]"
      );
      if (!target) return;
      if (target.dataset.action === "cancel-reservation" && target.dataset.code) {
        void cancelReservation(target.dataset.code);
      }
    });

    const stored = localStorage.getItem(EMAIL_KEY);
    const input = maybe<HTMLInputElement>("dr-lookup-email");
    if (stored && input) {
      input.value = stored;
      renderMine();
    }
  }

  function init(): void {
    bindMine();

    // Deep-linking: /dinner-reservations?date=YYYY-MM-DD opens that month.
    const params = new URLSearchParams(window.location.search);
    const dateParam = params.get("date");
    if (dateParam && /^\d{4}-\d{2}-\d{2}$/.test(dateParam)) {
      const d = parseKey(dateParam);
      if (!Number.isNaN(d.getTime()) && dateParam >= todayKey) {
        view = { year: d.getFullYear(), month: d.getMonth() };
      }
    }

    renderBody();
    void loadMonth(view.year, view.month);
  }

  init();
</script>

