---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import VersionHistory from "../components/VersionHistory.astro";
import { buildHistory } from "../lib/history";

const entry = await getEntry("pages", "architecture");
if (!entry) throw new Error("Missing 'architecture' entry in the pages collection");
const { Content } = await render(entry);
const revisions = buildHistory(entry.filePath);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  currentPath="/architecture"
>
  <section class="content-body">
    <span class="eyebrow">{entry.data.eyebrow}</span>
    <h1>{entry.data.title}</h1>
    <Content />
  </section>

  <VersionHistory revisions={revisions} />
</BaseLayout>
