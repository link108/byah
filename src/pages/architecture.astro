---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import VersionSwitcher from "../components/VersionSwitcher.astro";
import { buildHistory } from "../lib/history";

const entry = await getEntry("pages", "architecture");
if (!entry) throw new Error("Missing 'architecture' entry in the pages collection");
const { Content } = await render(entry);
const revisions = buildHistory(entry.filePath);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  currentPath="/architecture"
>
  <header class="content-body post-header">
    <div>
      <span class="eyebrow">{entry.data.eyebrow}</span>
      <h1>{entry.data.title}</h1>
    </div>
    <VersionSwitcher revisions={revisions} contentId="post-content" />
  </header>
  <div id="post-content" class="content-body">
    <Content />
  </div>
</BaseLayout>
