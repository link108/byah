---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getPublishedPosts } from "../../lib/content";

const posts = await getPublishedPosts();
---

<BaseLayout
  title="Blog"
  description="Writing about software, systems, and ongoing experiments."
  currentPath="/blog"
>
  <section>
    <span class="eyebrow">Blog</span>
    <h1>Writing</h1>
    <p class="content-body">
      Notes on engineering, decision-making, side projects, and the boring parts that
      usually matter most.
    </p>
    <p class="content-body">
      I use AI to help organize and draft these from my own notes and arguments. Each
      post is tagged with roughly how much AI input went into it, and every post is
      versioned — you can see how it changed over time on the post itself.
    </p>
  </section>

  <section class="entry-list">
    {posts.length > 0 ? (
      posts.map((post) => <PostCard post={post} />)
    ) : (
      <p class="content-body">Nothing published here yet.</p>
    )}
  </section>
</BaseLayout>
