---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import VersionHistory from "../../components/VersionHistory.astro";
import { formatDate } from "../../lib/format";
import { buildHistory } from "../../lib/history";
import { getSeriesPosts, getSeriesLength } from "../../lib/content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const revisions = buildHistory(post.filePath);

const seriesPosts = post.data.series ? await getSeriesPosts(post.data.series.name) : [];
const seriesLength = post.data.series ? await getSeriesLength(post.data.series.name) : 0;
const seriesIndex = seriesPosts.findIndex((p) => p.slug === post.slug);
const prevInSeries = seriesIndex > 0 ? seriesPosts[seriesIndex - 1] : null;
const nextInSeries =
  seriesIndex >= 0 && seriesIndex < seriesPosts.length - 1 ? seriesPosts[seriesIndex + 1] : null;
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  currentPath="/blog"
>
  <article>
    <header class="content-body">
      <span class="eyebrow">Blog Post</span>
      <h1>{post.data.title}</h1>
      <div class="meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {post.data.series && (
          <span>{post.data.series.name} · Part {post.data.series.order} of {seriesLength}</span>
        )}
        {post.data.tags.map((tag: string) => <span>#{tag}</span>)}
      </div>
    </header>
    <div class="content-body section-rule" style="margin-top: 1.5rem;">
      <Content />
    </div>
    {(prevInSeries || nextInSeries) && (
      <nav class="content-body series-nav" aria-label="Series navigation">
        <span>
          {prevInSeries ? (
            <a href={`/blog/${prevInSeries.slug}/`}>&larr; {prevInSeries.data.title}</a>
          ) : null}
        </span>
        <span>
          {nextInSeries ? (
            <a href={`/blog/${nextInSeries.slug}/`}>{nextInSeries.data.title} &rarr;</a>
          ) : null}
        </span>
      </nav>
    )}
  </article>

  <VersionHistory revisions={revisions} />
</BaseLayout>
