---
import BaseLayout from "../layouts/BaseLayout.astro";

const region = "Sonoma County, CA";

interface PlaceInput {
  name: string;
  icon: string;
  description: string;
  query?: string;
}

function place({ name, icon, description, query }: PlaceInput) {
  const searchName = query ?? name;
  const mapsQuery = encodeURIComponent(`${searchName} ${region}`);
  const yelpDesc = encodeURIComponent(searchName);
  const yelpLoc = encodeURIComponent(region);
  return {
    name,
    icon,
    description,
    mapsUrl: `https://www.google.com/maps/search/?api=1&query=${mapsQuery}`,
    yelpUrl: `https://www.yelp.com/search?find_desc=${yelpDesc}&find_loc=${yelpLoc}`
  };
}

const daveroWebsite = "https://davero.com/";
const davero = place({
  name: "DaVero",
  icon: "🍇",
  query: "DaVero Farms & Winery",
  description:
    "Biodynamic farm and winery outside Healdsburg growing Italian and Rhône varietals — Sangiovese, Dolcetto, Vermentino — alongside some of Sonoma's best olive oil."
});

const dinnerSpots = [
  place({
    name: "Russian River Brewing",
    icon: "🍺",
    description:
      "Home of Pliny the Elder — one of the most-hyped double IPAs in American craft beer — plus a full pub menu."
  }),
  place({
    name: "Sonoma Pizza Co",
    icon: "🍕",
    description: "Wood-fired pizza for a casual, no-fuss dinner after a day of tasting."
  }),
  place({
    name: "Main Street Bistro",
    icon: "🍽️",
    description: "Casual bistro fare in the middle of Guerneville, sometimes with live music on the patio."
  }),
  place({
    name: "Stumptown Brewery",
    icon: "🍺",
    description:
      "Dog-friendly beer garden and BBQ joint right on Main Street — a solid warm-up for Saturday's festival."
  }),
  place({
    name: "Boon",
    icon: "🌿",
    description: "Farm-to-table plates in a low-key Guerneville setting — the more composed option on this list."
  }),
  place({
    name: "Three Cultures",
    icon: "🌍",
    description: "A blend of cuisines under one roof, for the table that can't agree on one kind of food."
  }),
  place({
    name: "Baked on the River",
    icon: "🥐",
    description:
      "Bakery and cafe for the morning after — pastries, coffee, and something to soak up last night's tasting."
  })
];

const festivalMenu = [
  { icon: "🍖", label: "Ribs" },
  { icon: "🍗", label: "Wings" },
  { icon: "🍺", label: "Beer" }
];
---

<BaseLayout
  title="Beer & BBQ"
  description="A long weekend in Guerneville — DaVero in Healdsburg, dinner on the river, and the Beer & BBQ Festival."
  currentPath="/beernbbq"
  noindex={true}
>
  <section class="content-body">
    <div class="hero">
      <p class="emoji-banner" aria-hidden="true">🍇 🍷 🔥 🍖 🍗 🍺</p>
      <h1>Guerneville: Wine, Smoke, and Whatever's Left in the Cooler</h1>
      <p class="hero-sub">
        Wine country Friday afternoon, then beer and barbecue Saturday. Home base is an
        Airbnb in Guerneville.
      </p>
      <div class="hero-badges">
        <span class="badge">📍 Guerneville, CA</span>
        <span class="badge">🏠 Airbnb weekend</span>
      </div>
    </div>

    <div class="day-card day-wine">
      <div class="day-head">
        <span class="day-icon" aria-hidden="true">🍷</span>
        <div>
          <p class="day-label">Friday, Aug 14</p>
          <h2>Healdsburg Wineries</h2>
        </div>
      </div>

      <div class="plan-card">
        <span class="plan-ribbon">Confirmed</span>
        <div class="plan-main">
          <span class="plan-icon" aria-hidden="true">{davero.icon}</span>
          <div>
            <a class="plan-name" href={daveroWebsite} target="_blank" rel="noopener noreferrer">
              {davero.name}
            </a>
            <div class="plan-chips">
              <span class="chip">🕞 3:30 PM</span>
              <span class="chip">🥂 Classic Flight</span>
            </div>
          </div>
        </div>
        <p>{davero.description}</p>
        <p class="place-links">
          <a class="link-pill" href={daveroWebsite} target="_blank" rel="noopener noreferrer">
            Website
          </a>
          <a class="link-pill" href={davero.mapsUrl} target="_blank" rel="noopener noreferrer">
            Map
          </a>
          <a class="link-pill" href={davero.yelpUrl} target="_blank" rel="noopener noreferrer">
            Yelp
          </a>
        </p>
      </div>

      <h3>🍽️ Dinner, TBD</h3>
      <p>Either back in Guerneville or still in Healdsburg — still deciding between:</p>
      <div class="place-list">
        {
          dinnerSpots.map((d) => (
            <details class="place">
              <summary>
                <span class="place-icon" aria-hidden="true">
                  {d.icon}
                </span>{" "}
                {d.name}
              </summary>
              <div class="place-body">
                <p>{d.description}</p>
                <p class="place-links">
                  <a class="link-pill" href={d.mapsUrl} target="_blank" rel="noopener noreferrer">
                    Map
                  </a>
                  <a class="link-pill" href={d.yelpUrl} target="_blank" rel="noopener noreferrer">
                    Yelp
                  </a>
                </p>
              </div>
            </details>
          ))
        }
      </div>
    </div>

    <div class="day-card day-bbq">
      <div class="day-head">
        <span class="day-icon" aria-hidden="true">🔥</span>
        <div>
          <p class="day-label">Saturday, Aug 15</p>
          <h2>Beer &amp; BBQ Festival</h2>
        </div>
      </div>
      <p>
        The main event: Guerneville's Beer &amp; BBQ Festival. Slower morning after
        yesterday's wine, then this for the rest of the day.
      </p>
      <div class="festival-grid" role="list">
        {
          festivalMenu.map((item) => (
            <div class="festival-item" role="listitem">
              <span class="festival-icon" aria-hidden="true">
                {item.icon}
              </span>
              <span>{item.label}</span>
            </div>
          ))
        }
      </div>
      <p class="place-links" id="live-links" hidden>
        <a class="link-pill" href="/beernbbq/beers">🍺 Rate beers live</a>
        <a class="link-pill" href="/beernbbq/food">🍖 Rate BBQ live</a>
        <a class="link-pill" href="/beernbbq/results">🏆 See results</a>
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  // beernbbq.astro is a prerendered static page - this page's server
  // never knows the viewer's timezone, so the "Saturday" gate below runs
  // client-side against the viewer's own device clock (good enough here:
  // everyone's at the same event). Links start `hidden` in the markup so
  // there's no flash of "live" links before this check runs.
  const liveAt = new Date(2026, 7, 15, 0, 0, 0); // Aug 15, 2026, local time
  if (new Date() >= liveAt) {
    document.getElementById("live-links")?.removeAttribute("hidden");
  }
</script>

<style>
  .hero {
    text-align: center;
    padding: 2rem 1.5rem 1.75rem;
    margin-bottom: 1.75rem;
    border-radius: 16px;
    background: linear-gradient(135deg, #5b1a3a 0%, #8c2f4b 35%, #d97b3f 75%, #f2a83c 100%);
    color: #fff;
  }

  .hero .emoji-banner {
    font-size: 2.1rem;
    letter-spacing: 0.4rem;
    margin: 0 0 0.75rem;
  }

  .hero h1 {
    font-size: 1.6rem;
    margin-bottom: 0.6rem;
    color: #fff;
  }

  .hero-sub {
    color: rgba(255, 255, 255, 0.92);
    max-width: 44ch;
    margin: 0 auto 1rem;
  }

  .hero-badges {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
    font-size: 0.85rem;
  }

  .day-card {
    border-radius: 14px;
    padding: 1.5rem;
    margin-bottom: 1.75rem;
    border: 1px solid var(--border);
  }

  .day-wine {
    background: linear-gradient(180deg, #fbf1f4 0%, #ffffff 60%);
    border-color: #e7c7d3;
  }

  .day-bbq {
    background: linear-gradient(180deg, #fff6e9 0%, #ffffff 60%);
    border-color: #f0d5a8;
  }

  .day-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.1rem;
  }

  .day-icon {
    font-size: 2.1rem;
    line-height: 1;
  }

  .day-label {
    margin: 0 0 0.1rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06rem;
    color: var(--muted);
  }

  .day-card h2 {
    margin: 0;
    font-size: 1.25rem;
  }

  .plan-card {
    position: relative;
    background: #fff;
    border: 1px solid #e7c7d3;
    border-radius: 12px;
    padding: 1.1rem 1.1rem 1rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 14px rgba(139, 47, 75, 0.1);
  }

  .plan-ribbon {
    position: absolute;
    top: -0.65rem;
    right: 1rem;
    background: #8c2f4b;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05rem;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
  }

  .plan-main {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 0.65rem;
  }

  .plan-icon {
    font-size: 2.25rem;
  }

  .plan-name {
    font-size: 1.2rem;
    font-weight: 700;
    text-decoration: none;
  }

  .plan-name:hover {
    text-decoration: underline;
  }

  .plan-chips {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.35rem;
    flex-wrap: wrap;
  }

  .chip {
    background: #fbe7ee;
    color: #8c2f4b;
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .place-list {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 0;
  }

  .place {
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 4px;
    padding: 0.6rem 0.75rem;
    background: #fff;
  }

  .place summary {
    cursor: pointer;
    font-weight: 600;
  }

  .place summary:hover {
    color: var(--accent);
  }

  .place-icon {
    display: inline-block;
    width: 1.4rem;
  }

  .place-body {
    padding-top: 0.5rem;
  }

  .place-body p {
    margin-bottom: 0.5rem;
  }

  .place-links {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0 !important;
  }

  /* .place-links sets display:flex at the same specificity as the browser's
     own [hidden] rule, so without this the hidden attribute alone wouldn't
     actually hide #live-links - see the date-gate script above. */
  .place-links[hidden] {
    display: none;
  }

  .link-pill {
    display: inline-block;
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.15rem 0.6rem;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .link-pill:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .festival-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin: 0.25rem 0 0;
  }

  .festival-item {
    flex: 1 1 110px;
    text-align: center;
    background: #fff;
    border: 1px solid #f0d5a8;
    border-radius: 12px;
    padding: 1rem 0.5rem;
    box-shadow: 0 4px 14px rgba(217, 123, 63, 0.1);
  }

  .festival-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: linear-gradient(135deg, #f2a83c, #d9502f);
    font-size: 1.6rem;
    margin: 0 auto 0.5rem;
  }
</style>
