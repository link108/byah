---
import { formatDate } from "../lib/format";
import type { HistoryEntry } from "../lib/history";

interface Props {
  revisions: HistoryEntry[];
}

const { revisions } = Astro.props;
const priorRevisions = revisions.filter((r) => !r.isCurrent);
---

{priorRevisions.length > 0 && (
  <section class="content-body section-rule history">
    <h2>History</h2>
    <p>
      This page is versioned — {priorRevisions.length} earlier
      {priorRevisions.length === 1 ? "version" : "versions"} below. Use the version
      dropdown above to read any of them.
    </p>
    <ol class="revision-list">
      {revisions.map((revision) => (
        <li>
          <div class="revision-meta">
            <time datetime={revision.date.toISOString()}>{formatDate(revision.date)}</time>
            <span class="revision-hash">{revision.shortHash}</span>
            <span class="revision-message">{revision.message}</span>
            {revision.isCurrent && <span class="current-badge">Current</span>}
          </div>
        </li>
      ))}
    </ol>
  </section>
)}

<style>
  .revision-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .revision-list > li {
    padding: 0.6rem 0;
    border-top: 1px solid var(--border);
  }

  .revision-list > li:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .revision-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .revision-hash {
    font-family: monospace;
    font-size: 0.85rem;
  }

  .revision-message {
    color: var(--fg);
  }

  .current-badge {
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.8rem;
  }
</style>
